# Ensure consistent LF line endings across all platforms to protect raw byte Ed25519 signature verification
* text=auto eol=lf
*.json text eol=lf
*.vmcchart text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sig binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.webm binary
*.mkv binary
*.avi binary
*.mov binary
*.mp3 binary
*.ogg binary
*.wav binary
