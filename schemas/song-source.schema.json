{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TERASGROUP/VRChat_MaiSongs/main/schemas/song-source.schema.json",
  "title": "VMCSongSourceMetadata",
  "description": "Source metadata schema for one VMC song in song.json. runtimeSlot selects a pre-registered VRChat URL slot.",
  "type": "object",
  "required": [
    "songId",
    "runtimeSlot",
    "version",
    "enabled",
    "title",
    "artist",
    "bpm",
    "genre",
    "tags",
    "media",
    "charts"
  ],
  "properties": {
    "songId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "runtimeSlot": {
      "type": "integer",
      "minimum": 0,
      "maximum": 511,
      "description": "Fixed runtime URL slot. Must be unique within the catalog."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "artist": {
      "type": "string",
      "minLength": 1
    },
    "bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "genre": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media": {
      "type": "object",
      "required": [
        "audio"
      ],
      "properties": {
        "audio": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "additionalProperties": false
        },
        "background": {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "video",
                "image"
              ]
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "charts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[1-7]$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "chartId",
          "level",
          "designer",
          "version"
        ],
        "properties": {
          "chartId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "level": {
            "type": "string",
            "minLength": 1
          },
          "designer": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
