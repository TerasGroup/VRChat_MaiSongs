{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TERASGROUP/VRChat_MaiSongs/main/schemas/songs.schema.json",
  "title": "VMCSongCatalogV2",
  "description": "Machine catalog for VRChat runtime-slot based song delivery. Runtime code selects pre-registered VRCUrl entries by slot and variant indexes; it never constructs URLs from strings.",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "catalogVersion",
    "publicBaseUrl",
    "pack",
    "runtime",
    "songCount",
    "chartCount",
    "songs",
    "catalogSha256"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "vmc-song-catalog/v2"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "catalogVersion": {
      "type": "integer",
      "minimum": 2
    },
    "publicBaseUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "pack": {
      "type": "object",
      "required": [
        "packId",
        "name",
        "version",
        "description"
      ],
      "properties": {
        "packId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "slotCount",
        "slotPadWidth",
        "registryUrl",
        "audioExtensions",
        "backgroundVideoExtensions",
        "backgroundImageExtensions",
        "jacketExtensions",
        "chartDifficulties"
      ],
      "properties": {
        "slotCount": {
          "type": "integer",
          "minimum": 1
        },
        "slotPadWidth": {
          "type": "integer",
          "minimum": 1
        },
        "registryUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "audioExtensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          }
        },
        "backgroundVideoExtensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          }
        },
        "backgroundImageExtensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          }
        },
        "jacketExtensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          }
        },
        "chartDifficulties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      },
      "additionalProperties": false
    },
    "songCount": {
      "type": "integer",
      "minimum": 0
    },
    "chartCount": {
      "type": "integer",
      "minimum": 0
    },
    "songs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "songId",
          "runtimeSlot",
          "version",
          "enabled",
          "title",
          "artist",
          "bpm",
          "genre",
          "tags",
          "media",
          "jacket",
          "charts"
        ],
        "properties": {
          "songId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "runtimeSlot": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "bpm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "genre": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "media": {
            "type": "object",
            "required": [
              "audio"
            ],
            "properties": {
              "audio": {
                "type": "object",
                "required": [
                  "variant",
                  "extension"
                ],
                "properties": {
                  "variant": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "extension": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "background": {
                "type": "object",
                "required": [
                  "type",
                  "variant",
                  "extension"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "video",
                      "image"
                    ]
                  },
                  "variant": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "extension": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "jacket": {
            "type": "object",
            "required": [
              "variant",
              "extension"
            ],
            "properties": {
              "variant": {
                "type": "integer",
                "minimum": 0
              },
              "extension": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "charts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chartId",
                "difficulty",
                "level",
                "designer",
                "version"
              ],
              "properties": {
                "chartId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "difficulty": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "level": {
                  "type": "string"
                },
                "designer": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "catalogSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
