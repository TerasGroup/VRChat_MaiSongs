{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TERASGROUP/VRChat_MaiSongs/main/schemas/songs.schema.json",
  "title": "VMCSongCatalog",
  "description": "Machine catalog schema for generated root songs.json",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "catalogVersion",
    "publicBaseUrl",
    "pack",
    "songCount",
    "chartCount",
    "songs",
    "catalogSha256"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "vmc-song-catalog/v1"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "catalogVersion": {
      "type": "integer",
      "minimum": 1
    },
    "publicBaseUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "pack": {
      "type": "object",
      "required": [
        "packId",
        "name",
        "version",
        "description"
      ],
      "properties": {
        "packId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "songCount": {
      "type": "integer",
      "minimum": 0
    },
    "chartCount": {
      "type": "integer",
      "minimum": 0
    },
    "songs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "songId",
          "version",
          "enabled",
          "title",
          "artist",
          "bpm",
          "genre",
          "tags",
          "media",
          "jacket",
          "charts"
        ],
        "properties": {
          "songId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "bpm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "genre": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "media": {
            "type": "object",
            "required": [
              "audio"
            ],
            "properties": {
              "audio": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  }
                },
                "additionalProperties": false
              },
              "background": {
                "type": "object",
                "required": [
                  "type",
                  "url"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "video",
                      "image"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "jacket": {
            "type": "object",
            "required": [
              "path",
              "url",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "charts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chartId",
                "difficulty",
                "level",
                "designer",
                "version",
                "path",
                "url",
                "bytes",
                "sha256"
              ],
              "properties": {
                "chartId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "difficulty": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "level": {
                  "type": "string"
                },
                "designer": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "path": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "catalogSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
